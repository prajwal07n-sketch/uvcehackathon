datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  LAB_ADMIN
}

enum HardwareCondition {
  NEW
  GOOD
  FAIR
}

enum HardwareStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
}

enum TransactionStatus {
  PENDING
  APPROVED
  CHECKED_OUT
  RETURNED
  OVERDUE
}

enum CadFormat {
  STEP
  STL
  OBJ
  SCRIPT
}

model User {
  id            String              @id @default(uuid())
  name          String?
  email         String              @unique
  emailVerified DateTime?
  image         String?
  avatar        String?
  passwordHash  String?
  usn           String?             @unique
  department    String?
  semester      Int?
  phone         String?
  isVerified    Boolean             @default(false)
  trustScore    Int                 @default(100)
  role          String              @default("STUDENT") // STUDENT or LAB_ADMIN
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  accounts      Account[]
  sessions      Session[]
  hardware      HardwareItem[]      @relation("UserHardware")
  transactions  RentalTransaction[] @relation("UserBorrowings")
  cadResources  CadResource[]       @relation("UserCadResources")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model HardwareItem {
  id              String              @id @default(uuid())
  title           String
  category        String              // Embedded Boards, Sensors, Actuators/Motors, Robotics Parts, Lab Tools
  description     String?
  specs           String              // JSON stringified technical specifications
  condition       String              @default("GOOD") // NEW, GOOD, FAIR
  maintenanceFee  Float               @default(0)
  securityDeposit Float               @default(0)
  campusLocation  String              // Central Library, Innovation Lab, Instrumentation Dept, ECE Workshop
  imageUrl        String?
  status          String              @default("AVAILABLE") // AVAILABLE, BOOKED, MAINTENANCE
  ownerId         String
  owner           User                @relation("UserHardware", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  transactions    RentalTransaction[]
}

model RentalTransaction {
  id                 String       @id @default(uuid())
  hardwareId         String
  hardware           HardwareItem @relation(fields: [hardwareId], references: [id], onDelete: Cascade)
  borrowerId         String
  borrower           User         @relation("UserBorrowings", fields: [borrowerId], references: [id], onDelete: Cascade)
  startDate          DateTime
  endDate            DateTime
  status             String       @default("PENDING") // PENDING, APPROVED, CHECKED_OUT, RETURNED, OVERDUE
  meetupSpot         String?
  handoverNotes      String?
  conditionPhotoUrl  String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model CadResource {
  id                     String    @id @default(uuid())
  title                  String
  description            String?
  fileUrl                String
  previewMeshUrl         String?
  fileFormat             String    @default("STL") // STEP, STL, OBJ, SCRIPT
  softwareUsed           String    // SolidWorks, Fusion 360, FreeCAD, Onshape, OpenSCAD
  materialRecommendation String    // PLA, PETG, ABS, PEEK, Carbon Fiber Nylon
  infillPercent          Int       @default(20)
  toleranceNotes         String?
  licenseType            String    @default("CC-BY-SA 4.0")
  downloadsCount         Int       @default(0)
  fileSize               String    @default("1.2 MB")
  uploaderId             String
  uploader               User      @relation("UserCadResources", fields: [uploaderId], references: [id], onDelete: Cascade)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}
