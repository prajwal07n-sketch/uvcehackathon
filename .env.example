# ==========================================
# CAMPUS-SHARE ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Database Connection (SQLite default for rapid local prototyping)
DATABASE_URL="file:./dev.db"

# 2. NextAuth Authentication Secret & App URL
NEXTAUTH_SECRET="campus_share_super_secret_jwt_key_2026_uvce"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Universal Email Authentication
# Accepts ANY email address (academic .edu/.ac.in or personal gmail/outlook/etc.) with immediate activation.
ALLOW_ALL_EMAILS="true"
NEXT_PUBLIC_ALLOW_ALL_EMAILS="true"
ADDITIONAL_ALLOWED_DOMAINS="gmail.com,yahoo.com,outlook.com,hotmail.com,icloud.com,proton.me"
ALLOWED_CAMPUS_DOMAINS=".edu,.ac.in,.edu.in,campus.edu,campus.ac.in"

# 4. Optional: Google OAuth Credentials (Google Cloud Console -> OAuth 2.0)
# Callback URL to register in Google Console: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
